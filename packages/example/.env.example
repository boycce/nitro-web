# Vars are loaded from .env, then .env.local is merged over the top.

# Development — required
emailFrom=Nitro<support@nitro.com>
emailReplyTo=Nitro<support@nitro.com>
emailTestMode=true
mongoUrl=localhost:27017/nitro-dev
name=Nitro

# Development — services
awsAccessKeyId=
awsAcl=
awsBucket=nitro-dev
awsRegion=ap-southeast-2
awsSecretAccessKey=
awsUrl=https://s3-ap-southeast-2.amazonaws.com/
googleMapsApiKey=
mailgunDomain=mg.nitro.com
mailgunKey=
stripePublishableKey=
stripeSecretKey=
stripeWebhookSecret=

# Development — optional
# autoAddExistingUsers=
# isNotMultiTenant=
# limitOneTenantPerUser=
# logHeaders=
# masterPassword=
placeholderEmail=bruce@wayneenterprises.com
# PORT=
# portServer=

# Production
# mongoUrl=mongodb+srv://{USER}:{PASS}@cluster-us-east.p3uus.mongodb.net/{COLLECTION}?retryWrites=true&w=majority
