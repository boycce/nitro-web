{
  "semi": false,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 100,
  "bracketSpacing": true,
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.js"],
      "options": {
        "tabWidth": 2,
        "bracketSameLine": true,
        "singleAttributePerLine": false
      }
    }
  ]
}
